/* =========================================================
   APPLICATION
   ========================================================= */

Screen {
    layout: vertical;
}


/* =========================================================
   HEADER
   ========================================================= */

Header {
    height: 1;
}


/* =========================================================
   CONNECTION STATUS
   ========================================================= */

#status_indicator {
    width: 100%;
    height: 3;

    padding: 1 2;

    align-vertical: middle;
}


#status_label {
    width: auto;

    margin-right: 1;

    content-align: left middle;
}


#status_state {
    width: auto;

    text-style: bold;
    color: red;

    content-align: left middle;
}


/* =========================================================
   CONNECTION CONTROLS
   ========================================================= */

#buttons {
    width: 100%;
    height: 4;

    padding: 0 2;

    align-vertical: middle;
}


#buttons Button {
    width: 14;
    height: 3;

    margin-right: 1;
}


/* =========================================================
   SECTION TITLES
   ========================================================= */

.section_title {
    width: 90%;
    height: 1;

    text-style: bold;
    color: $warning;
}


/* =========================================================
   SUBSCRIPTIONS
   ========================================================= */

#subscriptions_container {
    width: 100%;
    height: auto;

    align-horizontal: center;

    padding: 1 0 0 0;
}


#subscriptions {
    width: 90%;
    height: 4;

    align: center middle;
}


#subscriptions Checkbox {
    width: 16;
    height: 3;

    margin: 0 1;
}

/* =========================================================
   MARKET TABLE
   ========================================================= */

#table_container {
    width: 100%;
    height: 1fr;

    align-horizontal: center;
}


#table_container .section_title {
    width: 70;
}


#market_table {
    width: 70;
    height: 1fr;

    overflow-x: hidden;
    overflow-y: hidden;
}


/* =========================================================
   ACTIVITY
   ========================================================= */

#activity_container {
    width: 100%;
    height: 6;

    padding: 1 2;
}


#activity_1,
#activity_2,
#activity_3 {
    width: 100%;
    height: 1;
}


/* =========================================================
   FOOTER
   ========================================================= */

Footer {
    height: 1;
}
